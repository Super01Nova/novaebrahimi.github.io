{% comment %}
  Overlay project card: the thumbnail fills the whole card, and the title and
  description sit in a translucent panel on the right side of the image.
  Replaces al-folio's default horizontal card. Styles live in assets/css/main.scss.
{% endcomment %}
{% if project.redirect %}
  {% assign project_link = project.redirect %}
{% else %}
  {% assign project_link = project.url | relative_url %}
{% endif %}

<div class="col mb-4">
  <a class="project-overlay-card" href="{{ project_link }}">
    {% if project.img %}
      <img
        class="project-overlay-img"
        src="{{ project.img | relative_url }}"
        alt="{{ project.title | escape }}"
        loading="lazy"
      >
    {% endif %}
    <div class="project-overlay-panel">
      <h3 class="project-overlay-title">{{ project.title }}</h3>
      {% if project.description %}
        <p class="project-overlay-desc">{{ project.description }}</p>
      {% endif %}
    </div>
  </a>
</div>